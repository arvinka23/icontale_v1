{
  "name": "icontale",
  "version": "2.0.0",
  "description": "Multiplayer emoji storytelling game — write stories, guess authors, score points.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:css": "cleancss -o public/styles.min.css public/styles.css",
    "audit": "npm audit --audit-level=high",
    "docker:build": "docker build -t icontale .",
    "docker:run": "docker run -p 3000:3000 icontale"
  },
  "keywords": [
    "game",
    "multiplayer",
    "storytelling",
    "emoji",
    "socket.io",
    "express",
    "real-time"
  ],
  "author": "Arvin Ka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvinka23/icontale_v1.git"
  },
  "homepage": "https://arvinka23.github.io/icontale",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.5.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

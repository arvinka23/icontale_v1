{
  "name": "icontale",
  "version": "3.0.0",
  "description": "Multiplayer emoji storytelling game — write stories, guess authors, score points.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "tsx server.ts",
    "build": "tsc",
    "dev": "tsx watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:css": "cleancss -o public/styles.min.css public/styles.css",
    "build:assets": "node scripts/build-assets.js",
    "build:icons": "node scripts/generate-icons.js",
    "audit": "npm audit --audit-level=high",
    "docker:build": "docker build -t icontale .",
    "docker:run": "docker run -p 3000:3000 icontale"
  },
  "keywords": [
    "game",
    "multiplayer",
    "storytelling",
    "emoji",
    "socket.io",
    "express",
    "real-time"
  ],
  "author": "Arvin Ka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvinka23/icontale_v1.git"
  },
  "homepage": "https://arvinka23.github.io/icontale",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "canvas": "^3.2.1",
    "clean-css": "^5.3.3",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.5.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

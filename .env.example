# ── IconTale Environment Configuration ────────────────────────
# Copy this file to .env and adjust values as needed.

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # debug | info | warn | error

# Security
ALLOWED_ORIGINS=*        # Comma-separated list of allowed origins, or * for all
MAX_LOBBIES=100          # Maximum concurrent lobbies
TRUST_PROXY=1            # Number of trusted proxy hops in front of the server
                         # (Render/Railway/Heroku: 1). Also accepts strings like
                         # 'loopback', 'uniquelocal' or a comma-separated CIDR list.

# Redis (required for persistence, achievements, and replays)
REDIS_URL=redis://localhost:6379

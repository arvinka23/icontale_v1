# ── IconTale Environment Configuration ────────────────────────
# Copy this file to .env and adjust values as needed.

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug          # debug | info | warn | error

# Security
ALLOWED_ORIGINS=*        # Comma-separated list of allowed origins, or * for all
MAX_LOBBIES=100          # Maximum concurrent lobbies
TRUST_PROXY=1            # Number of trusted proxy hops in front of the server
                         # (Render/Railway/Heroku: 1). Also accepts strings like
                         # 'loopback', 'uniquelocal' or a comma-separated CIDR list.
SOCKET_AUTH_SECRET=      # 16+ character secret used to sign Socket.io handshake
                         # tokens. REQUIRED in production; dev uses a fallback.
ENFORCE_SOCKET_AUTH=     # When set to '1' or 'true', reject socket connections
                         # that fail token verification. Default: log-only so
                         # rollout can be observed before enforcement flips on.

# Redis (required for persistence, achievements, and replays)
REDIS_URL=redis://localhost:6379
